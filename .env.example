# Copy to .env and fill in the values from your Supabase project
# (Project Settings → API). .env is gitignored; only this template is committed.

# ── Client (required) ────────────────────────────────────────────────────────
# Read by src/integrations/supabase/client.ts via import.meta.env, so these MUST
# carry the VITE_ prefix — Vite only exposes prefixed vars to browser code.
# The publishable key is the anon/public key and is safe to ship to the client.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# ── SSR fallbacks (optional) ─────────────────────────────────────────────────
# Same two values without the VITE_ prefix. src/integrations/supabase/client.ts
# and auth-middleware.ts fall back to these during server-side rendering.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# ── Server only (never expose to the client) ─────────────────────────────────
# Used by src/integrations/supabase/client.server.ts. Bypasses row-level
# security — keep it out of anything VITE_ prefixed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
