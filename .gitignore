# Dependencies
node_modules/
bun.lockb
package-lock.json

# Environment — ignore every real env file, but keep the committed template
.env*
!.env.example

# Build output
dist/
build/
.vite/

# Supabase (keep migrations, but ignore local config with secrets)
supabase/.temp/
supabase/.branches/
*.local.*.vercel/
.vercel
.DS_Store
graphify-out/

# Ruflo runtime state — config and agent/skill definitions are tracked,
# but the memory DBs, vector index, daemon state and metrics are per-machine.
.swarm/
ruvector.db
.claude-flow/daemon.pid
.claude-flow/daemon-state.json
.claude-flow/metrics/
.claude-flow/policy/state.json
.claude/checkpoints/
